{
  "manifest_version": 3,
  "name": "Parsify — Persian Chat Reader",
  "version": "1.1.1",
  "description": "Persian typography, readable math and beautiful code for Gemini and Google AI Studio. All rendering stays on your device.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_title": "Parsify" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [{
    "matches": ["https://gemini.google.com/*", "https://aistudio.google.com/*"],
    "js": ["content.js"],
    "css": ["fonts.css"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["fonts/*", "reader.css", "katex.css", "fonts.css"],
    "matches": ["https://gemini.google.com/*", "https://aistudio.google.com/*"]
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
